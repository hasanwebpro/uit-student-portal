# Copy to .env — `npm run launch` creates one for you (including a fresh JWT_SECRET). Empty values mean "use the default".
PORT=3000
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent   (default: debug in development, info in production)
LOG_LEVEL=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=uit_portal
MYSQL_POOL_MAX=10

# REQUIRED in production, at least 32 characters:  openssl rand -base64 48
# Without it (development only) a random key is generated per start, so every restart signs everyone out.
JWT_SECRET=

# Load FICTIONAL demo data into an empty database. Default: on in development, OFF in production (the demo password is public).
SEED_DEMO=

# Number of reverse proxies in front of the app, so rate limits and logs see the real client IP. Default: 1 in production.
TRUST_PROXY=

# Cookies are Secure in production. Set false only to try a production build over plain http on a LAN.
COOKIE_SECURE=
